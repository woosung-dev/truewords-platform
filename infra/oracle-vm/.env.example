# Oracle Cloud ARM VM 통합 Compose의 환경 변수 템플릿.
# VM 의 ~/truewords/.env 로 복사해 채우고 chmod 600 을 유지합니다.

# --- 이미지 태그 (make deploy-* 가 자동 갱신) ---------------------------------
# git rev-parse --short HEAD 값. make deploy-backend / deploy-admin 이 sed 로 교체합니다.
BACKEND_TAG=
ADMIN_TAG=
WEB_TAG=

# --- Qdrant -------------------------------------------------------------------
# openssl rand -base64 32 로 생성합니다.
QDRANT_API_KEY=
# 이전할 Qdrant 컬렉션 이름을 설정합니다.
COLLECTION_NAME=malssum_poc_v5
# 이전할 시맨틱 캐시 컬렉션 이름을 설정합니다.
CACHE_COLLECTION_NAME=semantic_cache

# --- Postgres (같은 VM, /opt/postgres/data 에 bind mount) ----------------------
# compose 의 postgres 서비스가 최초 기동 때 이 값으로 DB 를 생성합니다.
# 기동 후 변경해도 기존 볼륨에는 반영되지 않으니 처음에 확정하세요.
POSTGRES_USER=truewords
POSTGRES_PASSWORD=
POSTGRES_DB=truewords
# backend 가 쓰는 연결 문자열. 호스트는 compose 서비스명(postgres)입니다.
# 예: postgresql+asyncpg://truewords:<password>@postgres:5432/truewords
DATABASE_URL=

# --- Cloudflare Tunnel --------------------------------------------------------
# Zero Trust → Networks → Tunnels → truewords-oracle에서 토큰을 복사합니다.
CLOUDFLARE_TUNNEL_TOKEN=

# --- 운영 알림 (ops-check.sh → ntfy.sh) ---------------------------------------
# ntfy.sh 토픽 이름. 계정 없이 https://ntfy.sh/<topic> 으로 푸시가 갑니다.
# 토픽 이름이 곧 비밀이므로 추측 불가능하게 만듭니다:
#   echo "truewords-$(openssl rand -hex 8)"
# 폰의 ntfy 앱(iOS/Android)에서 같은 토픽을 구독합니다. FAIL/WARN 일 때만 옵니다.
# 비워 두면 ops-check.sh 는 알림 없이 로그·JSON·종료코드만 남깁니다.
NTFY_TOPIC=

# --- 애플리케이션 -------------------------------------------------------------
# 운영 환경에서는 production으로 설정합니다.
ENVIRONMENT=production
# production 검증을 통과하려면 true로 설정합니다.
COOKIE_SECURE=true
# 운영 Gemini API 키.
#
# ⚠️ 이 키는 GCP 프로젝트 **d-project-497004 ("D-Project")** 소유이며 계정은
#    jangwooseng97@gmail.com 입니다. 인프라 작업에 쓰던 jetaime-dev /
#    jetaime.jang@gmail.com 이 **아닙니다.**
#
#    이름에 TrueWords 가 없어 무관해 보이지만 **서비스의 유일한 외부 의존**이고,
#    프로젝트를 지우거나 키를 회수하면 챗봇이 즉시 죽습니다. 2026-06-04 에
#    woosung-dev 를 "안 쓰는 프로젝트" 로 지워 Qdrant VM 을 잃은 이력이 있습니다.
#    확인 근거: docs/dev-log/2026-07-30-gcp-neon-residual-audit.md
GEMINI_API_KEY=
# 기존 운영 환경의 free 또는 paid 값을 입력합니다.
# 비워 두면 free 로 떨어져 적재 배치마다 60초 sleep 이 걸리므로 반드시 채웁니다.
GEMINI_TIER=
# 기존 운영용 비밀값을 입력하며 기본값을 사용하면 안 됩니다.
ADMIN_JWT_SECRET=
# 관리자/사용자 웹의 독립 공개 origin (배포 승인 시 확정, host-only 쿠키 유지).
ADMIN_FRONTEND_URL=
WEB_FRONTEND_URL=
