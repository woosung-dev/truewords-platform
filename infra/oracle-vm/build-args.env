# 운영 web/admin 이미지의 빌드 인자 — release.yml 과 make deploy-web/admin 이 같은 값을 읽는다.
#
# 여기 값은 브라우저 번들에 그대로 구워지는 공개 값이라 커밋한다. 비밀은 절대 넣지 않는다
# (GHCR 이미지는 공개다). 시연 관리자 이메일도 admin 번들에 구워져 공개되는 값이지만, 저장소
# 원본에 하드코딩하지 않는다는 결정(ADR 2026-09-05 D6)에 따라 저장소 Variable DEMO_ADMIN_EMAIL 로 둔다.
#
# 왜 저장소 Variable 이 아니라 파일인가: 이미지 태그는 커밋 sha 이고 release.yml 은 같은 태그가
# 이미 있으면 다시 빌드하지 않는다. 플래그가 커밋 밖에 있으면 같은 sha 가 언제 빌드됐느냐에 따라
# 내용이 달라지고, 플래그만 바꾼 변경은 "web 변경 없음" 으로 보여 배포되지도 않는다.
# 파일이면 플래그 변경이 곧 커밋이고 deploy-services 가 web/admin 변경으로 잡는다.
#
# 형식: KEY=VALUE 한 줄씩. 따옴표·공백 없이.
NEXT_PUBLIC_API_URL=http://backend:8080
NEXT_PUBLIC_WEB_URL=https://truewords.woosung.dev
NEXT_PUBLIC_ADMIN_URL=https://truewords-admin.woosung.dev
# [확인 필요] 도메인 전환(메인 도메인 → web, admin.<도메인> → admin)은 위 두 값과 VM .env 의
# WEB_FRONTEND_URL·ADMIN_FRONTEND_URL 을 함께 바꾼다. 절차: README §도메인 전환. 쿠키는 하위 도메인끼리 공유하지 않는다.
# 훈독 (PLAN-HD-001 결정 10) · 오늘의 책갈피 (PLAN-HD-012 결정 5)
NEXT_PUBLIC_HOONDOK_ENABLED=1
NEXT_PUBLIC_HOONDOK_CARDS=1
# 부엉이 마스코트 (B 길잡이) — 2026-11-03 운영 켬. 문제 시 0 으로 바꾸는 PR 로 끈다
NEXT_PUBLIC_HOONDOK_MASCOT=1
# 7일 정성 (읽기 정성 1a) — 배포 순서: backend·시드 → 웹 OFF → 내부 확인 → API·웹 ON. 켤 때는 API HOONDOK_PATHS_ENABLED 와 함께
NEXT_PUBLIC_HOONDOK_PATHS=0
