{
  "include": [
    "apps/api/app",
    "apps/api/tests"
  ],
  "exclude": [
    "apps/admin",
    "apps/web",
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/dist",
    "**/build"
  ],
  "venvPath": "apps/api",
  "venv": ".venv",
  "pythonVersion": "3.12",
  "extraPaths": ["apps/api"],
  "reportMissingImports": "warning",
  "reportMissingTypeStubs": "none"
}
