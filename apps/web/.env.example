# Next.js build 시 프록시와 앱 간 링크에 반영된다. 비밀값을 넣지 않는다.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# 훈독(/hoondok/*) 기능 플래그. 1 이면 라우트를 켠다. 기본·운영 이미지는 OFF(404).
NEXT_PUBLIC_HOONDOK_ENABLED=0
# 훈독 프리뷰 플래그. 1 이면 준비 중 탭(말씀·가정예배)과 말씀 검색 진입을 켠다. 운영 미노출(Dockerfile·Makefile 미배선).
NEXT_PUBLIC_HOONDOK_PREVIEW=0
# 함께 읽는 모임 킬 스위치(PLAN-HD-010). 미설정 = OFF, 배포(Dockerfile·deploy-web)는 1. 로컬도 켜 둔다.
NEXT_PUBLIC_HOONDOK_TOGETHER=1
