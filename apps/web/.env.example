# Next.js build 시 프록시와 앱 간 링크에 반영된다. 비밀값을 넣지 않는다.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# 훈독 기능 플래그 — 웹 루트(/, /read …) 전체. 1 이면 화면을 켠다. 기본·운영 이미지는 OFF(모든 화면 404).
NEXT_PUBLIC_HOONDOK_ENABLED=0
# 함께 읽는 모임 킬 스위치(PLAN-HD-010). 미설정 = OFF, 배포(Dockerfile·deploy-web)는 1. 로컬도 켜 둔다.
NEXT_PUBLIC_HOONDOK_TOGETHER=1
# 오늘의 책갈피(PLAN-HD-012). 미설정 = OFF(홈 카드 없음·/bookmarks·/c/* 404). 배포 기본 0, 로컬은 켜 둔다.
NEXT_PUBLIC_HOONDOK_CARDS=1
# 부엉이 마스코트. 미설정 = OFF(지금 아이콘 그대로). 1 이면 빈 상태·오프라인·편성 없는 날에 부엉이가 들어간다.
NEXT_PUBLIC_HOONDOK_MASCOT=0
