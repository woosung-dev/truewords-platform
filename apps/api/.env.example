# === 환경 구분 ===
ENVIRONMENT=development  # development | staging | production

# === AI ===
GEMINI_API_KEY=your_gemini_api_key_here

# === Qdrant ===
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=malssum_poc_v5

# === PostgreSQL ===
DATABASE_URL=postgresql+asyncpg://truewords:truewords@localhost:5432/truewords

# === Admin JWT ===
ADMIN_JWT_SECRET=change-me-in-production
ADMIN_JWT_EXPIRE_MINUTES=1440
# 훈독 일반 사용자 쿠키(hoondok_token) 만료. 기본 7일. 서명 키는 ADMIN_JWT_SECRET 공유(aud 로 분리)
HOONDOK_JWT_EXPIRE_MINUTES=10080

# === 훈독 제한 베타 게이트 (PLAN-HD-001 Phase 3 F) ===
# 설정하면 가입(POST /hoondok/auth/signup)에 같은 초대 코드가 필요하다(누락·불일치 403 INVITE_REQUIRED).
# 비어 있거나 없으면 기존 동작 — 로컬·E2E 는 비워 둔다. 운영 값은 VM .env 에만 둔다.
# HOONDOK_INVITE_CODE=

# === 훈독 Web Push VAPID (PLAN-HD-006) ===
# 3값을 모두 설정하면 훈독 알림 구독이 열린다. 하나라도 비어 있으면 GET /hoondok/push/config 가
# enabled=false 를 내고 POST /hoondok/me/push 는 409 PUSH_DISABLED 다. 로컬·E2E 는 비워 둔다.
# 키 쌍은 `uv run vapid --gen` (py-vapid) 로 만들고 운영 값은 VM .env 에만 둔다.
# HOONDOK_VAPID_PUBLIC_KEY=
# HOONDOK_VAPID_PRIVATE_KEY=
# HOONDOK_VAPID_SUBJECT=mailto:admin@example.com

# === 훈독 함께 읽는 사람들 1단계 (PLAN-HD-009, API-HD-029) ===
# 오늘 훈독하기 완료자가 기준 미만이면 숫자를 내려보내지 않는다. 캐시 0 = 매 요청 집계.
# HOONDOK_TOGETHER_MIN_COUNT=10
# HOONDOK_TOGETHER_CACHE_SECONDS=60

# === 훈독 AI 낭독 목소리 (PLAN-HD-011) ===
# Google Cloud Text-to-Speech(Chirp 3 HD) API 키. 비어 있으면 기능 OFF — GET /hoondok/tts/voices 가 enabled=false,
# 단락 음성은 503 TTS_DISABLED 이고 화면은 브라우저 음성으로 돌아간다. 로컬·E2E 는 비워 둔다.
# 운영 키는 Text-to-Speech API 전용으로 제한해 VM .env 에만 둔다(infra/oracle-vm/README.md).
# GOOGLE_TTS_API_KEY=
# 달(America/Los_Angeles, Google 청구 달)마다 새로 합성하는 글자 수 상한(캐시 적중 제외). 기본 900000 = 무료 100만 자의 90%.
# HOONDOK_TTS_MONTHLY_CHAR_LIMIT=900000
# 사용자 한 명이 최근 24시간에 새로 합성할 수 있는 글자 수. 넘으면 429 TTS_USER_LIMIT_EXCEEDED.
# HOONDOK_TTS_USER_DAILY_CHAR_LIMIT=30000
# 합성 mp3 저장 위치. 기본 apps/api/var/hoondok-tts (git 무시). 운영은 /data/tts-cache 볼륨.
# 쓸 수 없으면 기능이 꺼진다(enabled=false) — 권한을 먼저 맞춘다.
# HOONDOK_TTS_CACHE_DIR=var/hoondok-tts

# === 시연 관리자 게이트 (ponytail, 시연 종료 후 role 기반으로 교체) ===
# admin API 를 허용할 단 하나의 계정 이메일. 비어 있으면 admin API 전부 403 (채팅은 무관).
# 로컬은 scripts/create_admin.py 로 만든 계정을 넣는다. E2E 는 demo-admin@example.com 을 쓴다.
DEMO_ADMIN_EMAIL=demo-admin@example.com

# === Frontend CORS ===
ADMIN_FRONTEND_URL=http://localhost:3001
WEB_FRONTEND_URL=http://localhost:3000

# === Cookie 보안 (프로덕션에서 true) ===
COOKIE_SECURE=false

# === 임베딩 파이프라인 ===
# GEMINI_TIER 하나로 무료/유료 전환. 개별 override도 가능.
#
# ┌───────────────────────────┬──────────────┬──────────────────┐
# │ 항목                      │ free         │ paid             │
# ├───────────────────────────┼──────────────┼──────────────────┤
# │ TPM 한도                  │ 30K          │ 1,000,000        │
# │ RPM 한도                  │ 100          │ 3,000            │
# │ RPD 한도                  │ 1,000        │ 무제한            │
# │ → max_chars_per_batch     │ 31,000자     │ 900,000자        │
# │ → batch_sleep             │ 60초         │ 3초              │
# │ → rpd_limit               │ 950          │ 100,000          │
# └───────────────────────────┴──────────────┴──────────────────┘
#
GEMINI_TIER=free   # free | paid
#
# 개별 override (선택사항 — 프리셋 대신 직접 지정):
# EMBED_MAX_CHARS_PER_BATCH=31000
# EMBED_BATCH_SLEEP=60
# EMBED_RPD_LIMIT=950

# === Semantic Cache ===
CACHE_COLLECTION_NAME=semantic_cache
CACHE_THRESHOLD=0.93
CACHE_TTL_DAYS=7
