{
  "name": "truewords-platform",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --filter=@truewords/web --filter=@truewords/admin",
    "dev:web": "pnpm --filter @truewords/web dev",
    "dev:admin": "pnpm --filter @truewords/admin dev",
    "dev:api": "pnpm --filter @truewords/api dev",
    "build": "turbo run build --filter=@truewords/web --filter=@truewords/admin",
    "test": "turbo run test --filter=!@truewords/api --filter=!@truewords/e2e",
    "typecheck": "turbo run typecheck --filter=!@truewords/api",
    "lint": "turbo run lint --filter=!@truewords/api",
    "test:e2e": "pnpm --filter @truewords/e2e test",
    "contracts:export": "pnpm --filter @truewords/api contracts:export",
    "contracts:generate": "pnpm contracts:export && pnpm sdk:generate",
    "sdk:generate": "openapi-ts -f tooling/codegen/openapi-ts.config.mjs",
    "contracts:check": "node tooling/checks/contracts.mjs",
    "docs:check": "node tooling/checks/docs-links.mjs",
    "boundaries:check": "node tooling/checks/boundaries.mjs",
    "tooling:test": "node --test tooling/checks/*.test.mjs"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "vitest": "4.1.2"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.7",
      "@hono/node-server": "1.19.17",
      "@humanfs/node": "0.16.8",
      "body-parser": "2.3.0",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@5": "5.0.9",
      "browserslist": "4.28.9",
      "fast-uri": "3.1.7",
      "hono": "4.12.34",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.2",
      "postcss": "8.5.28",
      "postcss-selector-parser": "7.1.6",
      "qs": "6.16.0",
      "undici": "7.29.1",
      "vite": "8.0.16"
    }
  }
}
